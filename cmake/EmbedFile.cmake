# embed_files(<output.cpp> <symbol> <file> [<symbol> <file> ...])
#
# Generates a C++ source defining, for every <symbol>:
#   extern const unsigned char <symbol>[];
#   extern const unsigned int  <symbol>_size;
# The output is only rewritten when its content changes.
function(embed_files out_cpp)
    set(args ${ARGN})
    set(content "// Generated by cmake/EmbedFile.cmake - do not edit.\n")
    while(args)
        list(POP_FRONT args symbol file)
        file(READ "${file}" hex HEX)
        string(LENGTH "${hex}" hex_len)
        math(EXPR size "${hex_len} / 2")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" bytes "${bytes}")
        string(APPEND content
            "extern const unsigned char ${symbol}[];\n"
            "extern const unsigned int  ${symbol}_size;\n"
            "alignas(4) const unsigned char ${symbol}[] = {\n${bytes}\n};\n"
            "const unsigned int ${symbol}_size = ${size};\n\n")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
    endwhile()
    file(CONFIGURE OUTPUT "${out_cpp}" CONTENT "${content}" @ONLY)
endfunction()
